## Conferência das afirmações do texto

As conclusões escritas acima citam números da execução. A célula abaixo relê os resultados e confere as principais afirmações, cada uma com uma pequena folga. Se o notebook for reexecutado em outro ambiente e algum resultado mudar de forma relevante, a diferença aparece aqui.

#%% code
k3v, proposta, abc, rf, informada = (comparacao_reguas.loc[n] for n in [
    "K-means, 3 variáveis (5 grupos)", "K-means, 4 variáveis: a proposta (5 grupos)", "curva ABC (5 faixas de valor)",
    "RF por regras (5 grupos)", "régua informada: 3 faixas de valor × teve estorno (6 grupos)"])
expoente = resumo_escala["expoente de crescimento"]
ari_k = diag["ARI reamostragem (média)"]
atrito_ano2 = resultado_futuro["estornos por 100 pedidos no ano 2"]
variacao_sazonal = monitor["maior variação de participação (p.p.)"]
conferencia = [
    ("Cinco segmentos, cada um com 18% a 22% dos clientes", perfil["% dos clientes"].min(), perfil["% dos clientes"].between(18, 22).all()),
    ("ARI por reamostragem do modelo final acima de 0,95", ari_media, ari_media > 0.95),
    ("k = 5 é mais estável que k = 4 e k = 6", ari_k[5], ari_k[5] > max(ari_k[4], ari_k[6])),
    ("K-means é mais estável que o hierárquico (Ward)", comparacao_alg.loc["Hierárquico (Ward)", "ARI por reamostragem"],
     comparacao_alg.loc["K-means", "ARI por reamostragem"] > comparacao_alg.loc["Hierárquico (Ward)", "ARI por reamostragem"] + 0.2),
    ("Modelo congelado e modelo do ano 2 concordam (ARI acima de 0,85)", ari_estrutura, ari_estrutura > 0.85),
    ("Participação muda menos de 4 p.p. entre dezembro de 2010 e de 2011", participacao["diferença (p.p.)"].abs().max(),
     participacao["diferença (p.p.)"].abs().max() < 4),
    ("Abstenção no ano 2 abaixo de 2%", 100 * (dist2 > LIMIAR).mean(), (dist2 > LIMIAR).mean() < 0.02),
    ("Recompra de A supera a de E em mais de 50 p.p.", resultado_futuro.loc["A", "recompra (%)"] - resultado_futuro.loc["E", "recompra (%)"],
     resultado_futuro.loc["A", "recompra (%)"] - resultado_futuro.loc["E", "recompra (%)"] > 50),
    ("Segmento C tem o maior atrito no ano 2", atrito_ano2.max(), atrito_ano2.idxmax() == "C"),
    ("K-means com 3 variáveis fica a menos de 0,03 da curva ABC em recompra e valor",
     max(abs(k3v["recompra"] - abc["recompra"]), abs(k3v["valor futuro (log)"] - abc["valor futuro (log)"])),
     max(abs(k3v["recompra"] - abc["recompra"]), abs(k3v["valor futuro (log)"] - abc["valor futuro (log)"])) < 0.03),
    ("A proposta fica abaixo da curva ABC em recompra e em valor", proposta["valor futuro (log)"] - abc["valor futuro (log)"],
     proposta["recompra"] < abc["recompra"] and proposta["valor futuro (log)"] < abc["valor futuro (log)"]),
    ("A proposta separa o atrito ao menos 2 vezes melhor que a curva ABC e que o RF", proposta["atrito futuro"] / max(abc["atrito futuro"], rf["atrito futuro"]),
     proposta["atrito futuro"] > 2 * max(abc["atrito futuro"], rf["atrito futuro"])),
    ("A régua informada iguala a proposta em atrito (diferença menor que 0,01)", informada["atrito futuro"] - proposta["atrito futuro"],
     abs(informada["atrito futuro"] - proposta["atrito futuro"]) < 0.01),
    ("A régua informada supera a proposta em recompra e em valor", informada["valor futuro (log)"] - proposta["valor futuro (log)"],
     informada["recompra"] > proposta["recompra"] and informada["valor futuro (log)"] > proposta["valor futuro (log)"]),
    ("Participação sazonal: alguma janela intermediária varia mais de 5 p.p.", variacao_sazonal.iloc[1:-1].max(), variacao_sazonal.iloc[1:-1].max() > 5),
    ("Custo do K-means cresce com expoente abaixo de 1,3", expoente["K-means"], expoente["K-means"] < 1.3),
    ("Custo do hierárquico cresce com expoente acima de 1,7", expoente["Hierárquico (Ward)"], expoente["Hierárquico (Ward)"] > 1.7),
]
conferencia_df = pd.DataFrame(conferencia, columns=["afirmação", "valor nesta execução", "confere"])
conferencia_df["confere"] = conferencia_df["confere"].map({True: "sim", False: "NÃO"})
display(conferencia_df.round(3))
print(f"{(conferencia_df['confere'] == 'sim').sum()} de {len(conferencia_df)} afirmações conferem nesta execução.")

